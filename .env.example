# Add a PostgreSQL database through the Vercel Marketplace (for example, Neon).
# Copy the provider's pooled connection string here for local development.
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used only by npm run db:seed-admin. Choose a long, unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
